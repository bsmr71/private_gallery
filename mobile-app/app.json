{
  "expo": {
    "name": "Lumina",
    "slug": "private-gallery",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bsmrlab.lumina"
    },
    "android": {
      "package": "com.bsmrlab.lumina",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Izinkan Private Gallery menggunakan autentikasi biometrik."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Private Gallery memerlukan akses foto untuk mengunggah media ke brankas terenkripsi Anda."
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "24e23022-ebfa-486d-bba6-6380d3b6cecf"
      }
    },
    "owner": "bsmr71"
  }
}
